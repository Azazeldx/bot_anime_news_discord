# Salin pengaturan ini ke .env untuk pemakaian lokal; webhook ada di tabel README.
GEMINI_API_KEY=
# Opsional: key cadangan dari project/akun Google lain (lihat README)
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_INTERVAL=6
# Opsional, kurasi Areaanime (lihat README)
AREAANIME_GEMINI_MODEL=gemini-flash-latest
X_RSS_URL=
X_ACCOUNTS=
# Opsional, channel Twitter (lihat README)
X_TWITTER_ACCOUNTS=
X_MAX_AGE_HOURS=24
# Opsional, channel Leaks (Sugoi LITE lewat Telegram) & kelengkapan data (lihat README)
DISCORD_WEBHOOK_LEAKS=
X_LEAKS_ACCOUNTS=
TELEGRAM_CHANNELS=
TELEGRAM_MAX_AGE_HOURS=24
# Opsional, channel Digest: file teks berita baru untuk ChatGPT/Claude (lihat README)
DISCORD_WEBHOOK_DIGEST=
DIGEST_MAX_ITEMS=200
DIGEST_MIN_ITEMS=100
DIGEST_INTERVAL_HOURS=2
SOURCE_LIMIT=15
NEWS_MAX_AGE_HOURS=48
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
